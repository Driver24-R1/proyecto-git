
/* ===== VARIABLES ===== */
:root {
  --yt-bg: #0f0f0f;
  --yt-header: rgba(20, 20, 20, 0.85);
  --yt-hover: #272727;
  --yt-chip: #272727;
  --yt-text: #ffffff;
  --yt-gray: #aaaaaa;
}

/* ===== BODY ===== */
body {
  margin: 0;
  min-height: 100vh;
  position: relative;
  overflow: hidden;
  color: var(--yt-text);
  padding-top: 56px;
}

/* Fondo borroso */
body::before {
  content: "";
  position: fixed;
  inset: 0;
  background-image: url("../png/fondo.png");
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;

  filter: blur(8px);
  transform: scale(1.1); /* evita bordes feos */
  z-index: -1;
}


/* ===== fondo =====*/
.acceso-box {
  max-width: 350px;
  margin: 30px auto;
  padding: 10px;

  background: rgba(20, 20, 20, 0.85);
  border: 1px solid var(--yt-border);
  border-radius: 16px;

  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4);
}

.acceso-box h1 {
  text-align: center;
  color: #FFFFFF;
}

.acceso-box form {
  padding: 0 40px;
  box-sizing: border-box;
}

form .correo {
  display: flex;
  flex-direction: column;
  gap: 6px;
  margin-bottom: 10px;
}

.correo input {
  width: 100%;
  padding: 0 10px;
  height: 25px;
  font-size: 12px;
  border: 1px solid var(--yt-border);
  background: rgba(20, 20, 20, 0.9);
  border-radius: 16px;
  color: #ffffff;
}

.correo label {
  color: #ffffff;
  font-size: 14px;
}

.recordar {
  margin: -5 0 20px 5px;
  color: blue;
  cursor: pointer;
  padding: 5px;
}
.recordar:hover {
  text-decoration: underline;
}

/* ===== Enviar datos =====*/
input[type="submit"] {
  width: 100%;
  height: 40px;
  border: 1 solid;
  background: rgba(20, 20, 20, 0.9);
  border-radius: 25px;
  font-size: 18px;
  color: #ffffff;
  cursor: pointer;
  outline: none;
}
input[type="submit"]:hover {
  border-color: aqua;
  transition: .5s;
}

.registar {
  margin: 30px 0;
  text-align: center;
  font-size: 16px;
}
.registar a {
  text-decoration: underline;
}



.password-wrapper {
  position: relative;
}
.password-wrapper input {
  width: 100%;
  padding-right: 10px; /* espacio para el ojo */
}


.toggle-password {
  position: absolute;
  right: -10px;
  top: 50%;
  transform: translateY(-50%);
  cursor: pointer;
  opacity: 0.7;
}

.toggle-password:hover {
  opacity: 1;
}

.eye-icon {
  width: 20px;
  height: 20px;
  fill: #ffffff;
  display: block;
}

/* Ajuste móvil */
@media (max-width: 480px) {
  .eye-icon {
    width: 22px;
    height: 22px;
  }
}



form .nombre {
  display: flex;
  flex-direction: column;
  gap: 6px;
  margin-bottom: 15px;
}



.fila {
  display: flex;
  gap: 25px;
}

.fila .correo {
  flex: 1; /* ambos ocupan lo mismo */
}

/*esto es para celular*/
@media (max-width: 600px) {

  /* cajas solo se reducen, no cambian forma */

  .acceso-box {
    max-width: 340px;
  }

  /* evita desbordes laterales */
  body {
    overflow-x: hidden;
  }

  /* mantiene fila, solo reduce espacio */
  .fila {
    gap: 25px;
  }
  .fila .correo {
    flex: 1; /* ambos ocupan lo mismo */
  }

  /* evita que el ojo se salga */
  .toggle-password {
    right: -10px;
  }

  .password-wrapper {
    position: relative;
  }
  .password-wrapper input {
    width: 100%;
    padding-right: 10px; /* espacio para el ojo */
  }

  .acceso-box {
    max-width: 90%;
    margin: 20px auto;
    padding: 10px;
    border-radius: 14px;
  }
}

